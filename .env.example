# Copy this to .env.local for local development
# NEVER commit .env.local to GitHub

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — product analytics. Leave unset and analytics is simply off,
# nothing breaks (see src/lib/analytics.js). Get the key from your PostHog
# project settings; host depends on which region you signed up in
# (us.i.posthog.com or eu.i.posthog.com).
# VITE_POSTHOG_KEY=phc_your-project-key-here
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# This goes in Netlify environment variables only (server-side)
# ANTHROPIC_API_KEY=your-anthropic-key-here
