# Copy this to .env.local for local development
# NEVER commit .env.local to GitHub

# ---- Client-side (VITE_ prefix — bundled into the browser, never secret) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — product analytics. Leave unset and analytics is simply off,
# nothing breaks (see src/lib/analytics.js). Get the key from your PostHog
# project settings; host depends on which region you signed up in
# (us.i.posthog.com or eu.i.posthog.com).
# VITE_POSTHOG_KEY=phc_your-project-key-here
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---- Server-side only (Netlify environment variables — never in the client bundle) ----

# Supabase service role — bypasses RLS entirely. Used only by
# netlify/functions/*.js, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 5th-pass audit fix (2026-08-26): the two vars below were both load-bearing
# in production already but missing from this file entirely — a fresh
# deploy standing up its environment from this file alone would have had
# bot verification silently broken (TURNSTILE_SECRET_KEY) and every
# Growth/Team scan silently stop chaining after round 1
# (INTERNAL_SCAN_SECRET), in both cases with nothing pointing at why.

# Bot verification on signup (Login.jsx calls verify-turnstile.js before
# signUp — "the one thing a bot can't skip", see that file's own header).
# Required for signup bot-protection to actually run; fails cleanly (a
# clear 500, not a confusing crash) if unset, but signup verification is
# then simply not happening. Get a site+secret key pair from the
# Cloudflare Turnstile dashboard.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Authenticates scan-now-background.js's own self-chaining calls, which is
# what lets a multi-round scan continue past round 1 for Growth/Team
# accounts (see SCAN_TIER_CONFIG in entitlements.js). Required for that
# tier's multi-round scanning to work at all — if this drifts out of sync
# between what's set and what the function checks against, chaining stops
# silently after round 1 with no visible error anywhere (see that file's
# own comment). Set this to any long random string; it just has to match
# what the function itself is configured to expect.
INTERNAL_SCAN_SECRET=your-internal-scan-secret-here

# AI research (chat.js, intelligence-scan.js, scan-now-background.js)
ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional — daily PLATFORM-WIDE (secondary, backstop) token spend cap; the
# primary protection is a per-customer cap, see
# supabase-migrations/2026-08-26-per-customer-credit-caps.sql and
# entitlements.js's resolveResourceCaps(). Raised 2026-08-26 once each
# customer had their own real per-customer budget — defaults to
# 4,000,000 tokens/day if unset (was 2,000,000 before that change; keep
# this comment in sync with DEFAULT_PLATFORM_CAPS in entitlements.js, the
# real source of truth, if it's ever tuned again).
# ANTHROPIC_DAILY_TOKEN_CAP=4000000
# Optional — per-user, per-minute call cap on chat.js. Defaults to 20 if unset.
# CHAT_PER_MINUTE_CAP=20

# Contact/company enrichment (scanShared.js, apollo-enrich-companies.js)
APOLLO_API_KEY=your-apollo-key-here
# Optional — daily PLATFORM-WIDE (secondary, backstop) Apollo credit cap;
# see the per-customer-credit-caps migration and entitlements.js note
# above — same 2026-08-26 change applies here. Defaults to 1,200/day if
# unset (was 500 before).
# APOLLO_DAILY_CREDIT_CAP=1200

# UK company verification (intelligence-scan.js, scan-now-background.js) — optional,
# scans still run without it, just without Companies House corroboration.
# COMPANIES_HOUSE_API_KEY=your-companies-house-key-here

# Job-posting discovery (intelligence-scan.js, scan-now-background.js) — optional.
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key

# UAE/GCC live-job discovery (Adzuna has no GCC coverage — see
# discoverTheirStackJobs in scanShared.js) — optional, that market just
# falls back to AI web search alone without it. Get a key at
# theirstack.com under API > API Keys.
# THEIRSTACK_API_KEY=your-theirstack-key-here
# Optional — daily PLATFORM-WIDE (secondary, backstop) TheirStack credit
# cap; see the per-customer-credit-caps migration and entitlements.js note
# above — same 2026-08-26 change applies here. Defaults to 3,000/day if
# unset (was 500, and 40, then 150, before that — raised again once the
# cost-analysis doc confirmed a flat 20 credits/customer/day on every tier,
# which 500 was already short of at the 50-100 client target scale).
# THEIRSTACK_DAILY_CREDIT_CAP=3000

# Transactional email (lib/email.js) — optional; emails are just skipped if unset.
# RESEND_API_KEY=your-resend-key-here
# RESEND_FROM_ADDRESS=Annie <hello@yourdomain.com>

# Ops alerting (scanShared.js alertIfConfigured) — optional; a Slack incoming
# webhook URL that gets a message when a scan run finds 0 signals across
# every customer (likely a suspended key or provider outage, not a quiet
# market), or when error-rate-monitor.js's hourly check finds a spike in
# error_logs (see that file for the threshold). Same webhook, two callers.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Observability: GET /api/health is public (no auth, no env var needed) and
# checks Supabase connectivity for an uptime monitor to poll. error-rate-
# monitor.js runs hourly on its own schedule and needs no separate config
# beyond SLACK_WEBHOOK_URL above. Neither is a substitute for a real APM/
# error tracker (Sentry or similar) — see README.md's "Known gaps" section.

# Billing — see STRIPE_SETUP.md for the full walkthrough. All optional until
# you turn on paid plans; the app degrades gracefully without them.
# STRIPE_SECRET_KEY=sk_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_YEARLY=price_...
# STRIPE_PRICE_GROWTH_MONTHLY=price_...
# STRIPE_PRICE_GROWTH_YEARLY=price_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_TEAM_YEARLY=price_...

# Used in redirect/return URLs (checkout success, billing portal return).
# Defaults to https://app.meetannie.ai if unset — set this for local/staging.
# APP_URL=http://localhost:8888

# Optional — link back to the marketing site from start-trial-checkout.js.
# Defaults to https://meetannie.ai if unset.
# MARKETING_URL=https://meetannie.ai

# Optional — where support-escalate.js emails a conversation that needs a
# real person (refund disputes, data requests, likely bugs, a direct ask
# for a human, three unresolved exchanges). Defaults to mstubbs@meetannie.ai
# if unset.
# SUPPORT_ESCALATION_EMAIL=you@yourdomain.com

# Optional — real APM/error tracking (reportError.js). Errors are always
# logged to the error_logs table regardless; setting this additionally
# sends them to Sentry. Get a DSN from your Sentry project settings.
# SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Optional — caps total redemptions of the marketing site's ?code=annie100
# free-month link (start-trial-checkout.js). Defaults to 50 if unset; set
# to 0 to retire the code entirely without a deploy (a genuine 0 is
# respected, not treated as unset — see parseIntEnv in lib/env.js).
# FREE_MONTH_MAX_REDEMPTIONS=50

# Optional — powers the feature-adoption panel on Annie Overview's Product
# & Engineering tab (admin-feature-adoption.js). This is a DIFFERENT key
# from VITE_POSTHOG_KEY above: that one is a public project key that can
# only ever send events; this one is a personal API key with query access,
# needed to read usage data back out. Get it from PostHog under Settings ->
# Personal API keys (needs the "query:read" scope) and your numeric
# project ID from Settings -> Project. Left unset, the panel shows a
# "connect PostHog" prompt instead of failing anything else on the page.
# POSTHOG_PERSONAL_API_KEY=phx_your-personal-api-key-here
# POSTHOG_PROJECT_ID=12345
