# Copy this to .env.local for local development
# NEVER commit .env.local to GitHub

# ---- Client-side (VITE_ prefix — bundled into the browser, never secret) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — product analytics. Leave unset and analytics is simply off,
# nothing breaks (see src/lib/analytics.js). Get the key from your PostHog
# project settings; host depends on which region you signed up in
# (us.i.posthog.com or eu.i.posthog.com).
# VITE_POSTHOG_KEY=phc_your-project-key-here
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---- Server-side only (Netlify environment variables — never in the client bundle) ----

# Supabase service role — bypasses RLS entirely. Used only by
# netlify/functions/*.js, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI research (chat.js, intelligence-scan.js, scan-now-background.js)
ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional — daily platform-wide token spend cap, see
# supabase-migrations/2026-08-22-anthropic-cost-cap-and-chat-rate-limit.sql.
# Defaults to 2,000,000 tokens/day if unset.
# ANTHROPIC_DAILY_TOKEN_CAP=2000000
# Optional — per-user, per-minute call cap on chat.js. Defaults to 20 if unset.
# CHAT_PER_MINUTE_CAP=20

# Contact/company enrichment (scanShared.js, apollo-enrich-companies.js)
APOLLO_API_KEY=your-apollo-key-here
# Optional — daily platform-wide Apollo credit cap, see
# supabase-migrations/2026-08-21-apollo-credit-cap.sql. Defaults to 500/day.
# APOLLO_DAILY_CREDIT_CAP=500

# UK company verification (intelligence-scan.js, scan-now-background.js) — optional,
# scans still run without it, just without Companies House corroboration.
# COMPANIES_HOUSE_API_KEY=your-companies-house-key-here

# Job-posting discovery (intelligence-scan.js, scan-now-background.js) — optional.
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key

# Transactional email (lib/email.js) — optional; emails are just skipped if unset.
# RESEND_API_KEY=your-resend-key-here
# RESEND_FROM_ADDRESS=Annie <hello@yourdomain.com>

# Ops alerting (scanShared.js alertIfConfigured) — optional; a Slack incoming
# webhook URL that gets a message when a scan run finds 0 signals across
# every customer (likely a suspended key or provider outage, not a quiet
# market), or when error-rate-monitor.js's hourly check finds a spike in
# error_logs (see that file for the threshold). Same webhook, two callers.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Observability: GET /api/health is public (no auth, no env var needed) and
# checks Supabase connectivity for an uptime monitor to poll. error-rate-
# monitor.js runs hourly on its own schedule and needs no separate config
# beyond SLACK_WEBHOOK_URL above. Neither is a substitute for a real APM/
# error tracker (Sentry or similar) — see README.md's "Known gaps" section.

# Billing — see STRIPE_SETUP.md for the full walkthrough. All optional until
# you turn on paid plans; the app degrades gracefully without them.
# STRIPE_SECRET_KEY=sk_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_YEARLY=price_...
# STRIPE_PRICE_GROWTH_MONTHLY=price_...
# STRIPE_PRICE_GROWTH_YEARLY=price_...
# STRIPE_PRICE_TEAM_MONTHLY=price_...
# STRIPE_PRICE_TEAM_YEARLY=price_...

# Used in redirect/return URLs (checkout success, billing portal return).
# Defaults to https://app.meetannie.ai if unset — set this for local/staging.
# APP_URL=http://localhost:8888
